<?xml version="1.0"?>
<!--
The listed modules form the calculation layer. cli is the interaction layer.
Installed-command verification checks explicitness separately, including CLI I/O.
-->
<ruleset name="messpy onion">
    <rule ref="onion">
        <properties>
            <property name="domain" value="*/src/messpy/analyzer.py,*/src/messpy/callables.py,*/src/messpy/callgraph.py,*/src/messpy/captures.py,*/src/messpy/constants.py,*/src/messpy/dependencies.py,*/src/messpy/effects.py,*/src/messpy/execution.py,*/src/messpy/names.py,*/src/messpy/onion.py,*/src/messpy/ownership.py,*/src/messpy/protocols.py,*/src/messpy/reachability.py,*/src/messpy/rulesets.py" />
            <property name="outer-layers" value="os,sys,tempfile,subprocess,messpy.cli" />
        </properties>
    </rule>
</ruleset>
